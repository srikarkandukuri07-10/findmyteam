# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Pre-launch lock (D19). Leave unset in production; "off" only for local work on the app.
# WAITLIST_MODE=off
# Keys the network fingerprint for the waitlist spam limit. Set in Vercel; optional locally.
# WAITLIST_HASH_SECRET=
